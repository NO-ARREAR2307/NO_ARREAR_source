# STUDYWISE AI backend - example configuration.
# Copy to .env (PowerShell: Copy-Item .env.example .env) and replace the placeholders.
# NEVER commit .env or put real credentials in this example file.

# ----- Required -----
# MongoDB Atlas connection string. Replace <username>, <password> and <cluster-url>.
# URL-encode special characters in the password (@ : / ? # %). Keep /studywise_ai as the database name.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/studywise_ai?retryWrites=true&w=majority

# JWT signing secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-generated-secret

# ----- Server -----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# Base URL of the frontend page that opens a shared question set (Phase 2C). Share links look like
# <SHARE_BASE_URL>/shared/<token>. Optional: defaults to the first CORS_ORIGIN.
# SHARE_BASE_URL=http://localhost:5173

# Public study material links (Phase 4.3A): per-IP request limit for GET /api/shared/materials/... (no login).
# Optional; defaults: 100 requests per 15 minutes.
# SHARED_ACCESS_LIMIT_MAX=100
# SHARED_ACCESS_LIMIT_WINDOW_MS=900000

# ----- Authentication -----
JWT_EXPIRES_IN=7d
# Password hashing cost, whole number from 10 to 15.
BCRYPT_SALT_ROUNDS=10

# ----- Rate limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ----- Study material uploads (all optional) -----
# Folder where uploaded files are stored. Leave unset to use backend/uploads/papers (the default). The folder is private:
# files are only ever served through GET /api/papers/:paperId/file after an ownership / admin check.
# PAPERS_UPLOAD_DIR=

# ----- Text extraction and OCR (all optional; these are the defaults) -----
PDF_TIMEOUT_MS=60000
MAX_PDF_PAGES=200
OCR_TIMEOUT_MS=90000
OCR_MAX_QUEUE=5
OCR_LANG=eng
# Folder with an uncompressed <lang>.traineddata file for fully offline OCR. Leave empty to
# let Tesseract.js download the language data once on the first OCR run.
OCR_LANG_PATH=
MAX_EXTRACTED_TEXT_CHARS=1000000
# Extract requests allowed per student per window.
EXTRACT_LIMIT_WINDOW_MS=900000
EXTRACT_LIMIT_MAX=20

# ----- Gemini AI (text question search: POST /api/questions/ask) -----
# Get a key at https://aistudio.google.com/apikey . Without it the endpoint answers 503.
GEMINI_API_KEY=
# Optional. Leave these commented out to use the defaults shown. Only set GEMINI_MODEL if you need a
# different model (see https://ai.google.dev/gemini-api/docs/models). Default: gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_MS=45000
# GEMINI_MAX_OUTPUT_TOKENS=8192
# GEMINI_THINKING_LEVEL=low

# ----- AI question generation (Phase 2E) -----
# Most questions one generation request (and one saved set) may contain. Whole number from 1 to 50.
# MAX_QUESTIONS_PER_REQUEST=30
# Phase 3C-2: most characters of uploaded paper text (all selected papers together) sent to Gemini in one
# generation request. Text over this limit is never cut off silently: the request is refused and the student is
# asked to select fewer or shorter papers. Whole number from 5000 to 400000. Default 120000.
# MAX_MATERIAL_CHARS_PER_REQUEST=120000

# ----- Email verification codes via Brevo SMTP (Phase 0B) -----
# New students get a 6-digit code by email (valid for 5 minutes). Create a free Brevo account, then:
#   1. Brevo > SMTP & API > SMTP: copy the SMTP login and generate an SMTP key.
#   2. Brevo > Senders, Domains & Dedicated IPs: add and verify the sender address below.
# Without these three values registration still works, but no email is sent (resend answers 503).
# Set all three or none. NEVER commit real values.
# The SMTP login looks like 9xxxxx001@smtp-brevo.com (it is NOT your account email).
BREVO_SMTP_USER=
# The SMTP key (NOT your Brevo account password and NOT an API key).
BREVO_SMTP_PASS=
# A sender address verified in Brevo. Emails come "from" this address.
EMAIL_FROM_ADDRESS=
# Optional (these are the defaults).
# EMAIL_FROM_NAME=STUDYWISE AI
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# 587 = STARTTLS (recommended), 465 = implicit TLS.
# BREVO_SMTP_PORT=587
# EMAIL_TIMEOUT_MS=15000
# Seconds a student must wait before asking for a new code (10 to 3600).
# OTP_RESEND_COOLDOWN_SECONDS=60
# Resend-code requests allowed per IP address per 15 minutes.
# OTP_RESEND_LIMIT_MAX=10
# Optional key (32+ characters) used to hash the codes. Leave empty to derive one from JWT_SECRET.
# OTP_HASH_SECRET=

# ----- Initial admin account (used ONLY by: npm run seed:admin) -----
# One-time setup. Fill these in, run `npm run seed:admin`, then DELETE ADMIN_PASSWORD from .env.
# The password needs at least 12 characters (maximum 72 bytes). Admins cannot be created through
# public registration. Never commit real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
