{
  "name": "studywise-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for STUDYWISE AI - an AI-powered semester examination preparation platform for college students.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "check:gemini": "node scripts/checkGemini.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "sync:academic-indexes": "node scripts/syncAcademicIndexes.js",
    "migrate:academic": "node scripts/migrateAcademicSchema.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "studywise-ai",
    "express",
    "mongodb",
    "mongoose",
    "mern"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.3",
    "morgan": "^1.12.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.5",
    "pdfjs-dist": "^5.4.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
